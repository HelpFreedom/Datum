# Скрипты установки ЗАПРЕЩЕНЫ. Иначе любой пакет в дереве — а их сотня —
# выполняет произвольный код при установке, и это самая дешёвая дорога для
# порчи цепочки поставки.
#
# Скрипты нужны ровно двум пакетам, и они собираются явно, в scripts/bootstrap.sh:
#   esbuild  — докачивает бинарник под платформу
#   node-pty — собирает нативный модуль
# Electron 44 скриптов установки не имеет: бинарник bootstrap.sh качает явно
# (install.js пакета, сверка по checksums.json).
ignore-scripts=true
fund=false
audit=false
