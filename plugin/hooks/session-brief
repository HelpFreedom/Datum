#!/bin/sh
# Хук плагина Datum: сводка проекта в контекст агента (datum/doc/brief.py) —
# при старте сессии, после /clear и после сжатия контекста. Новая сессия иначе
# восстанавливает картину чтением старых журналов и заметок, поэтому сессии
# вели до упора окна, а цена хода растёт с размером контекста.
# Нет окружения — тихо пропускаем: помощь не должна становиться поломкой.
py="${CLAUDE_PLUGIN_ROOT:-$(dirname "$0")/..}/../.venv/bin/python"
[ -x "$py" ] || exit 0
exec "$py" -m datum.cli session-brief
