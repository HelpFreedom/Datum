#!/bin/sh
# Хук плагина Datum: звать ли ИИ-критика (datum/doc/critic.py).
#   stop   — агент заканчивает ход: не дать, пока критик не видел выгруженное;
#   prompt — новое сообщение человека: круги критика считаются заново.
# Плагин лежит в репозитории Datum, и Python — его окружение. Нет окружения —
# тихо пропускаем: страховка не должна становиться поломкой.
py="${CLAUDE_PLUGIN_ROOT:-$(dirname "$0")/..}/../.venv/bin/python"
[ -x "$py" ] || exit 0
exec "$py" -m datum.cli critic-gate "$1"
